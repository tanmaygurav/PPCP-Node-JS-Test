# Copy to .env.test.local (ignored). Never commit populated credentials.
# Remote tests never fall back to the local TEST_ACCESS_KEY.
TEST_TARGET_ACCESS_KEY=
# Optional override for a recreated local milestone; otherwise uses .env.local TEST_ACCESS_KEY.
TEST_LOCAL_ACCESS_KEY=
# Optional Vercel deployment-protection automation bypass secret.
VERCEL_AUTOMATION_BYPASS_SECRET=

{
  "version": 2,
  "framework": null,
  "git": { "deploymentEnabled": { "codex/m04-event-poc": false, "milestone/m04-event-poc": false } },
  "buildCommand": "node build-deployment.mjs",
  "outputDirectory": "dist-deployment",
  "functions": { "api/index.js": { "maxDuration": 60 }, "api/m02.js": { "maxDuration": 60 }, "api/m04.js": { "maxDuration": 60 } },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index?route=:path*" }],
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "Referrer-Policy", "value": "no-referrer" },
    { "key": "Content-Security-Policy", "value": "default-src 'self'; connect-src 'self' https://www.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" }
  ] }]
}
